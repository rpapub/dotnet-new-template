<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>CPMForge.Template.Plus.Templates</PackageId>
    <PackageVersion>0.0.1</PackageVersion>
    <Title>UiPath Coded Activities — Plus Edition Template</Title>
    <Authors>Christian Prior-Mamulyan</Authors>
    <Copyright>Copyright (c) 2026 Christian Prior-Mamulyan</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>dotnet new template for UiPath VS-compiled coded activities (NativeActivity scope, split NuGet packages, ActivityDesigner chrome, xunit tests).</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**"
             Exclude="**\bin\**;**\obj\**;**\*.user;*.csproj;build\**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
