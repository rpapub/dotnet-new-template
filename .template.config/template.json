{
  "$schema": "http://json.schemastore.org/template",
  "author": "Christian Prior-Mamulyan / CPMForge",
  "classifications": ["UiPath", "Activities", "Coded Activities", "NativeActivity"],
  "identity": "CPMForge.UiPath.CustomActivities.Plus",
  "name": "UiPath Coded Activities — Plus Edition",
  "shortName": "cpmf-custom-activities",
  "description": "Scaffold for UiPath coded activities: NativeActivity scope, ActivityDesigner chrome, DesignPropertiesViewModel, split NuGet package, xunit tests.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "CPMForge.Template",
  "preferNameDirectory": true,
  "forms": {
    "noop": {
      "identifier": "noop"
    },
    "lastSegment": {
      "identifier": "replace",
      "pattern": "^.*\\.",
      "replacement": ""
    },
    "lastSegmentLower": {
      "identifier": "chain",
      "steps": [ "lastSegment", "lowerCaseInvariant" ]
    },
    "lowerCaseInvariant": {
      "identifier": "lowerCaseInvariant"
    }
  },
  "symbols": {
    "authors": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Christian Prior-Mamulyan",
      "description": "Author name used in NuGet metadata and copyright.",
      "replaces": "Christian Prior-Mamulyan"
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "parameters": {
        "format": "yyyy"
      },
      "replaces": "2026"
    },
    "workflowCompilerVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "26.0.0-alpha.22366",
      "description": "Version of uipath.workflowcompiler.windows in NUGET_PACKAGES.",
      "replaces": "26.0.0-alpha.22366"
    },
    "runtimeDesignVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "25.10.33",
      "description": "Version of uipath.uiautomation.activities.runtime.design in NUGET_PACKAGES.",
      "replaces": "25.10.33"
    },
    "nameForPaths": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "noop",
      "replaces": "CPMForgePath"
    },
    "sectionName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lastSegment",
      "replaces": "TplSection",
      "fileRename": "TplSection",
      "description": "Last dot-segment of the name (CPMForge.Sops -> Sops): the config section, its class and its default .toml."
    },
    "repoSlug": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lastSegmentLower",
      "replaces": "tplsection",
      "description": "Lower-cased last dot-segment, used in the manifest's repo name (cpmf-uipsl-sops)."
    },
    "demoProjectId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "5f3c9a7e-1b4d-4e8a-9c61-0d7e3b2a8f14",
      "parameters": { "defaultFormat": "d" }
    },
    "demoEntryPointId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "8e1d4b6c-3a9f-4c27-b5e0-7f2a6d9c1e83",
      "parameters": { "defaultFormat": "d" }
    }
  },
  "sources": [
    {
      "source": ".",
      "target": ".",
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            "build/**",
            "**/*.nupkg",
            "**/bin/**",
            "**/obj/**",
            "*.Templates.csproj",
            "template-overrides/**",
            "CPMForge.Template.Plus.slnx",
            "src/plus/CPMForge.Template.Api/CPMForge.Template.Api.csproj",
            "src/plus/CPMForge.Template.Design/CPMForge.Template.Design.csproj",
            "src/plus/CPMForge.Template.Packaging/CPMForge.Template.Packaging.csproj",
            "src/plus/CPMForge.Template.Tests/CPMForge.Template.Tests.csproj",
            "src/plus/RPAForge.TplSection.Packaging/RPAForge.TplSection.Packaging.csproj"
          ]
        }
      ]
    },
    {
      "source": "template-overrides",
      "target": "."
    }
  ],
  "primaryOutputs": [
    { "path": "CPMForge.Template.Plus.slnx" }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "args": {
        "executable": "dotnet",
        "args": "restore"
      },
      "manualInstructions": [{ "text": "Run: dotnet restore" }]
    }
  ]
}
