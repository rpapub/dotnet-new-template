{
  "$schema": "http://json.schemastore.org/template",
  "author": "Christian Prior-Mamulyan / CPMForge",
  "classifications": ["UiPath", "Activities", "Coded Activities", "NativeActivity"],
  "identity": "CPMForge.UiPath.CustomActivities.Plus",
  "name": "UiPath Coded Activities — Plus Edition",
  "shortName": "cpmf-custom-activities",
  "description": "Scaffold for UiPath coded activities: NativeActivity scope, ActivityDesigner chrome, DesignPropertiesViewModel, split NuGet package, xunit tests.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "CPMForge.Template",
  "preferNameDirectory": true,
  "forms": {
    "noop": {
      "identifier": "noop"
    }
  },
  "symbols": {
    "authors": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Your Name",
      "description": "Author name used in NuGet metadata and copyright.",
      "replaces": "Christian Prior-Mamulyan"
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "parameters": {
        "format": "yyyy"
      },
      "replaces": "2026"
    },
    "workflowCompilerVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "26.0.0-alpha.22366",
      "description": "Version of uipath.workflowcompiler.windows in NUGET_PACKAGES.",
      "replaces": "26.0.0-alpha.22366"
    },
    "runtimeDesignVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "25.10.33",
      "description": "Version of uipath.uiautomation.activities.runtime.design in NUGET_PACKAGES.",
      "replaces": "25.10.33"
    },
    "nameForPaths": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "noop",
      "replaces": "CPMForgePath"
    }
  },
  "sources": [
    {
      "source": ".",
      "target": ".",
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            "build/**",
            "**/*.nupkg",
            "**/bin/**",
            "**/obj/**",
            "*.Templates.csproj",
            "template-overrides/**",
            "CPMForge.Template.Plus.slnx",
            "src/coded/CPMForge.Template.Api/CPMForge.Template.Api.csproj",
            "src/coded/CPMForge.Template.Design/CPMForge.Template.Design.csproj",
            "src/coded/CPMForge.Template.Packaging/CPMForge.Template.Packaging.csproj",
            "src/coded/CPMForge.Template.Tests/CPMForge.Template.Tests.csproj"
          ]
        }
      ]
    },
    {
      "source": "template-overrides",
      "target": "."
    }
  ],
  "primaryOutputs": [
    { "path": "CPMForge.Template.Plus.slnx" }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "args": {
        "executable": "dotnet",
        "args": "restore"
      },
      "manualInstructions": [{ "text": "Run: dotnet restore" }]
    }
  ]
}
