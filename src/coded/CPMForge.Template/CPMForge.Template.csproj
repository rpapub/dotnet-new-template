<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <AssemblyName>CPMForge.Template</AssemblyName>
    <RootNamespace>CPMForge.Template</RootNamespace>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <!--
    Both TFMs compile against the same System.Activities reference assembly.
    net6.0-windows: Windows Robot / Studio (runtime provided by host)
    net6.0:         Cross-platform Robot on Linux (runtime provided by robot host at execution)
    System.Activities.dll is a compile-time contract; the robot host injects the runtime copy.

    CA1416 suppressed for net6.0: WF types are marked windows-only in the reference assembly
    but the portable Robot host provides System.Activities at runtime on Linux.

    SystemActivitiesDll resolved in Directory.Build.props from:
      $(NUGET_PACKAGES)\uipath.workflowcompiler.windows\$(UiPathWorkflowCompilerVersion)\WorkflowCompiler\System.Activities.dll
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Activities">
      <HintPath>$(SystemActivitiesDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
