<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      PublicLocal: the local feed this machine publishes to (just publish → Publish-ToNuGetFeed.ps1).
      Holds CPMForge.Config.Plus and the other CPMForge packages.
    -->
    <add key="PublicLocal" value="C:\Users\Public\NuGetFeed" />
    <!--
      Local flat feed. Required, not optional: the rules project references CPMForge.RulesSdk,
      which is published here and nowhere else. Without this source the rules project cannot restore.
    -->
    <add key="local-flat-feed" value="T:\nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
