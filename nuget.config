<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Local flat feed. Required, not optional: the rules template references
      WatchfulAnvil.Sdk and WatchfulAnvil.Build, which are published here and nowhere
      else. Without this source the rules project cannot restore.
    -->
    <add key="local-flat-feed" value="T:\nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
