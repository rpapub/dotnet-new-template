<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net6.0-windows</TargetFrameworks>
    <AssemblyName>Cpmf.CustomActivities.Api</AssemblyName>
    <RootNamespace>Cpmf.CustomActivities.Api</RootNamespace>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cpmf.CustomActivities\Cpmf.CustomActivities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Activities">
      <HintPath>$(SystemActivitiesDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Provides ICodedWorkflowsServiceRegistry, ICodedWorkflowsServiceLocator, ActivityContext -->
    <PackageReference Include="UiPath.CodedWorkflows" Version="24.10.2" />
  </ItemGroup>

</Project>
