<sap:ActivityDesigner
    x:Class="Cpmf.CodedActivities.Design.BuildConnectionDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
    xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <DockPanel MinWidth="280">
        <Grid DockPanel.Dock="Top" Margin="4,4,4,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" VerticalAlignment="Center" Margin="0,2" />
            <sapv:ExpressionTextBox Grid.Row="0" Grid.Column="1"
                Expression="{Binding Path=ModelItem.Server, Mode=TwoWay}"
                ExpressionType="s:String"
                OwnerActivity="{Binding Path=ModelItem}"
                HintText="host.example.com" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,2" />
            <sapv:ExpressionTextBox Grid.Row="1" Grid.Column="1"
                Expression="{Binding Path=ModelItem.Port, Mode=TwoWay}"
                ExpressionType="s:Int32"
                OwnerActivity="{Binding Path=ModelItem}"
                HintText="22" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,2" />
            <sapv:ExpressionTextBox Grid.Row="2" Grid.Column="1"
                Expression="{Binding Path=ModelItem.Username, Mode=TwoWay}"
                ExpressionType="s:String"
                OwnerActivity="{Binding Path=ModelItem}"
                HintText="svcaccount" Margin="0,2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Key File Path" VerticalAlignment="Center" Margin="0,2" />
            <sapv:ExpressionTextBox Grid.Row="3" Grid.Column="1"
                Expression="{Binding Path=ModelItem.KeyFilePath, Mode=TwoWay}"
                ExpressionType="s:String"
                OwnerActivity="{Binding Path=ModelItem}"
                HintText="C:\keys\id_rsa" Margin="0,2" />
        </Grid>

        <sap:WorkflowItemPresenter
            Item="{Binding Path=ModelItem.Body, Mode=TwoWay}"
            HintText="Drop activities here" />
    </DockPanel>

</sap:ActivityDesigner>
