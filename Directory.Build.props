<Project>

  <!--
    UiPath SDK reference assembly versions — update when upgrading the UiPath SDK.
    Resolved from NUGET_PACKAGES environment variable (standard NuGet global packages var).
    Set NUGET_PACKAGES to your NuGet global packages folder, e.g. T:\nuget\packages
  -->
  <PropertyGroup>
    <UiPathWorkflowCompilerVersion>26.0.0-alpha.22366</UiPathWorkflowCompilerVersion>
    <UiPathRuntimeDesignVersion>25.10.33</UiPathRuntimeDesignVersion>
    <SystemActivitiesDll>$(NUGET_PACKAGES)\uipath.workflowcompiler.windows\$(UiPathWorkflowCompilerVersion)\WorkflowCompiler\System.Activities.dll</SystemActivitiesDll>
    <SystemActivitiesMetadataDll>$(NUGET_PACKAGES)\uipath.uiautomation.activities.runtime.design\$(UiPathRuntimeDesignVersion)\build\net6.0-windows\System.Activities.Metadata.dll</SystemActivitiesMetadataDll>
    <SystemActivitiesPresentationDll>$(NUGET_PACKAGES)\uipath.uiautomation.activities.runtime.design\$(UiPathRuntimeDesignVersion)\build\net6.0-windows\System.Activities.Presentation.dll</SystemActivitiesPresentationDll>
  </PropertyGroup>

  <!-- CPMForge.Config.Plus: every library reads its own config section through it. -->
  <PropertyGroup>
    <CpmfConfigPlusVersion>0.3.0-alpha.3</CpmfConfigPlusVersion>
  </PropertyGroup>

  <!-- Package metadata -->
  <PropertyGroup>
    <Authors>Christian Prior-Mamulyan</Authors>
    <Company>CPMForge</Company>
    <Copyright>Copyright (c) 2026 Christian Prior-Mamulyan</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <!--
      No RepositoryUrl / RepositoryType on purpose: packaging copies them into the nuspec, and the
      template's own URL used to ship inside every library scaffolded from it. Source repos are
      private, so the pack pipeline points readers at the org front door instead
      (see cpmf-uipsl-config's Directory.Build.props for the full reasoning).
    -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
