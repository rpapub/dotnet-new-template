<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net6.0-windows</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddDlls</TargetsForTfmSpecificBuildOutput>
    <PackageType>activities</PackageType>
    <PackageId>CPMForge.Template.Plus</PackageId>
    <PackageOutputPath>../build/nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>CPMForge.Template Plus edition — UiPath coded activities (NativeActivity scope, ActivityDesigner chrome).</Description>
    <PackageTags>UiPath;Activities;NativeActivity;WF4;RPA;ActivityDesigner</PackageTags>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CPMForgePath\CPMForgePath.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\CPMForgePath.Api\CPMForgePath.Api.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\CPMForgePath.Design\CPMForgePath.Design.csproj"
                      Condition="'$(TargetFramework)' == 'net6.0-windows'">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <!--
    AddDlls: collect per-TFM DLLs from each project's own output directory.
    PrivateAssets=all on ProjectReferences prevents DLL copy to this project's OutputPath,
    so we reference each project's bin directly.
  -->
  <Target Name="AddDlls">
    <ItemGroup>
      <BuildOutputInPackage Include="..\CPMForgePath\bin\$(Configuration)\$(TargetFramework)\CPMForge.Template.dll" />
      <BuildOutputInPackage Include="..\CPMForgePath.Api\bin\$(Configuration)\$(TargetFramework)\CPMForge.Template.Api.dll" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0-windows'">
      <BuildOutputInPackage Include="..\CPMForgePath.Design\bin\$(Configuration)\$(TargetFramework)\CPMForge.Template.Design.dll" />
    </ItemGroup>
  </Target>

  <!-- Strip the empty Packaging project DLL from the package (keeps lib/ clean). -->
  <Target Name="RemoveMetaDll" AfterTargets="BuiltProjectOutputGroup">
    <ItemGroup>
      <BuiltProjectOutputGroupOutput Remove="@(BuiltProjectOutputGroupOutput)" />
    </ItemGroup>
  </Target>

  <!-- Delete old nupkg before each build to avoid stale versions accumulating. -->
  <Target Name="CleanOldNupkg" BeforeTargets="Build">
    <ItemGroup>
      <_OldPkg Include="$(PackageOutputPath)\$(PackageId)*.nupkg" />
    </ItemGroup>
    <Delete Files="@(_OldPkg)" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
